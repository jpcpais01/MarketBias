# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter API key. Server-side only — never prefix it with NEXT_PUBLIC_.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...


# ─────────────────────────────────────────────────────────────────────────────
# MODEL (change the model without touching any code)
# ─────────────────────────────────────────────────────────────────────────────

# Any model id from https://openrouter.ai/models.
# Pick one that follows JSON instructions reliably; the workflow needs it.
# Examples:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4o
#   google/gemini-2.5-pro
#   perplexity/sonar-reasoning   (has its own built-in search)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Use OpenRouter's web plugin so the forecaster can research live information.
# Adds cost per request. Disable only if your model already searches natively.
OPENROUTER_ENABLE_WEB_SEARCH=true

# Number of web results fed to the model per search.
OPENROUTER_WEB_MAX_RESULTS=8

# Send `response_format: {"type":"json_object"}`. Off by default because many
# models reject it; JSON is enforced by the prompt and a tolerant parser.
OPENROUTER_JSON_MODE=false

# Milliseconds before an OpenRouter call is aborted.
OPENROUTER_TIMEOUT_MS=240000

# Optional attribution shown on OpenRouter's leaderboards.
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_SITE_NAME=TrueOdds

# Override only if you proxy OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# ─────────────────────────────────────────────────────────────────────────────
# ANALYSIS STORAGE (forecasts are append-only and never overwritten)
# ─────────────────────────────────────────────────────────────────────────────

# auto   — Upstash if credentials exist, else filesystem locally, else memory
# upstash — Upstash Redis over REST (recommended on Vercel)
# fs      — one JSON file per analysis under ANALYSIS_STORE_DIR (local dev)
# memory  — in-process only; lost on restart
ANALYSIS_STORE_DRIVER=auto

# Required for the `upstash` driver. Create a database at https://upstash.com,
# or add Vercel's Upstash integration (which sets KV_REST_API_* automatically —
# both variable names are accepted).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Filesystem driver only. Relative paths resolve from the project root.
# ANALYSIS_STORE_DIR=.data/analyses

# Maximum records retained in the history index.
# ANALYSIS_STORE_MAX_RECORDS=500


# ─────────────────────────────────────────────────────────────────────────────
# POLYMARKET (public API — no key required)
# ─────────────────────────────────────────────────────────────────────────────

# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_REVALIDATE_SECONDS=60
# POLYMARKET_TIMEOUT_MS=20000
