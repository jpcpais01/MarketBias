# ═════════════════════════════════════════════════════════════════════════════
#  TrueOdds — environment configuration
#
#  Only ONE variable is required: OPENROUTER_API_KEY.
#  Everything below it is commented out and shows the built-in default, so if
#  you paste this file into Vercel's "Import .env" box you get just the two
#  variables you actually need. Uncomment a line only to change its value.
# ═════════════════════════════════════════════════════════════════════════════


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Server-side only — never prefix this with NEXT_PUBLIC_.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me


# ─── MODEL (optional — a good default is built in) ───────────────────────────

# Defaults to deepseek/deepseek-v4-flash-0731. Uncomment only to
# use a different model; any id from https://openrouter.ai/models works, as
# long as it follows JSON instructions (the workflow parses structured output
# at both stages).
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731


# ─── OPTIONAL — defaults shown; uncomment only to override ───────────────────

# Parallel forecasts averaged per research run. Each run is a separate LLM
# call, so 5 runs cost 5×. Runs happen concurrently, so wall time barely moves.
# Users can also pick per-research in the UI; this is the default selection.
# ANALYSIS_SAMPLE_RUNS=1

# Hard ceiling on runs, enforced server-side.
# ANALYSIS_MAX_SAMPLE_RUNS=8

# OpenRouter's web plugin, so the forecaster can research live information.
# Set false only if your model already searches natively.
# OPENROUTER_ENABLE_WEB_SEARCH=true
# OPENROUTER_WEB_MAX_RESULTS=8

# Send response_format={"type":"json_object"}. Off by default because many
# models reject it; JSON is enforced by the prompt and a tolerant parser.
# OPENROUTER_JSON_MODE=false

# OPENROUTER_TIMEOUT_MS=240000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Attribution shown on OpenRouter's leaderboards.
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_SITE_NAME=TrueOdds


# ─── STORAGE — needed on Vercel for a durable history ────────────────────────

# Vercel's filesystem is ephemeral. Without these two, forecasts are kept in
# memory and lost on restart (the dashboard warns you when that happens).
# Vercel's Upstash integration sets KV_REST_API_* instead — both names work.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# auto (default) | upstash | fs | memory
# ANALYSIS_STORE_DRIVER=auto
# ANALYSIS_STORE_DIR=.data/analyses
# ANALYSIS_STORE_MAX_RECORDS=500


# ─── POLYMARKET — public API, no key required ────────────────────────────────

# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_REVALIDATE_SECONDS=60
# POLYMARKET_TIMEOUT_MS=20000
